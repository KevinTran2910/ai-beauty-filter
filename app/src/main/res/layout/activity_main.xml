<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:orientation="vertical">

    <!-- Top action row (iOS-style pill). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_pink"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="Đổi cam"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Preview card (fills remaining space). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/preview_card">

        <SurfaceView
            android:id="@+id/texturePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/lblStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:text="Đang khởi tạo..."
            android:textColor="#777777"
            android:textSize="16sp" />
    </FrameLayout>

    <!-- Slider controls. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="Làm mịn"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seekSmoothing"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="60"
                    android:progressBackgroundTint="#555555"
                    android:progressTint="#ff5c8a"
                    android:thumbTint="#ff5c8a" />

                <TextView
                    android:id="@+id/lblSmoothing"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="6.0"
                    android:textColor="#ff5c8a"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="Trắng da"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seekWhitening"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="40"
                    android:progressBackgroundTint="#555555"
                    android:progressTint="#ff5c8a"
                    android:thumbTint="#ff5c8a" />

                <TextView
                    android:id="@+id/lblWhitening"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="4.0"
                    android:textColor="#ff5c8a"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="Thon mặt"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seekSlim"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="30"
                    android:progressBackgroundTint="#555555"
                    android:progressTint="#ff5c8a"
                    android:thumbTint="#ff5c8a" />

                <TextView
                    android:id="@+id/lblSlim"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="3.0"
                    android:textColor="#ff5c8a"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="To mắt"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seekEye"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="30"
                    android:progressBackgroundTint="#555555"
                    android:progressTint="#ff5c8a"
                    android:thumbTint="#ff5c8a" />

                <TextView
                    android:id="@+id/lblEye"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="3.0"
                    android:textColor="#ff5c8a"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="Má hồng"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seekBlush"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="20"
                    android:progressBackgroundTint="#555555"
                    android:progressTint="#ff5c8a"
                    android:thumbTint="#ff5c8a" />

                <TextView
                    android:id="@+id/lblBlush"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="2.0"
                    android:textColor="#ff5c8a"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
